{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@endfieldmap/map-core": ["./packages/map-core/src/index.ts"],
      "@endfieldmap/map-core/*": ["./packages/map-core/src/*"],
      "@endfieldmap/tools": ["./packages/tools/src/index.ts"],
      "@endfieldmap/tools/*": ["./packages/tools/src/*"],
      "@/": ["./src"],
      "@/*": ["./src/*"],
      "@eftypes/": ["./src/@types"],
      "@eftypes/*": ["./src/@types/*"],
      "@themes/": ["./src/components/themes"],
      "@themes/*": ["./src/components/themes/*"]
    }
  },
  "include": ["src"]
}
