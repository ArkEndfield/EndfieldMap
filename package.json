{
  "name": "endfieldmap",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev:web": "pnpm -C packages/map-web dev",
    "dev:native": "pnpm -C packages/map-native start",
    "dev:android": "pnpm -C packages/map-native android",
    "dev:android:local": "pnpm -C packages/map-native android:local",
    "dev:ios": "pnpm -C packages/map-native ios",
    "dev:ios:local": "pnpm -C packages/map-native ios:local",
    "build": "pnpm -r build",
    "build:web": "pnpm -C packages/map-web build",
    "build:android": "pnpm -C packages/map-native build:android",
    "build:ios": "pnpm -C packages/map-native build:ios",
    "lng:type": "pnpm -C packages/map-service lng:type",
    "build:core": "pnpm -C packages/map-core build",
    "build:adapter:ol": "pnpm -C packages/map-adapter-ol build",
    "build:adapter:maplibre": "pnpm -C packages/map-adapter-maplibre build",
    "build:tools": "pnpm -C packages/tools build",
    "build:service": "pnpm -C packages/map-service build",
    "build:storage:web": "pnpm -C packages/storage-web build",
    "build:storage:mmkv": "pnpm -C packages/storage-mmkv build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-class-static-block": "^7.28.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.2.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "unplugin-dts": "1.0.0-beta.6",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "^4.0.3"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.3.1",
      "typescript": "~5.9.3",
      "lightningcss": "1.30.1"
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@parcel/watcher",
      "@sentry/cli",
      "@swc/core",
      "esbuild",
      "protobufjs",
      "rxdb",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "react-scan": "^0.4.3"
  }
}
