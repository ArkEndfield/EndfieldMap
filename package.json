{
  "name": "endfieldmap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev:web": "pnpm -C apps/web dev",
    "preview:web": "pnpm -C apps/web preview",
    "dev:native": "pnpm -C apps/native start",
    "dev:android": "pnpm -C apps/native android",
    "dev:android:local": "pnpm -C apps/native android:local",
    "dev:ios": "pnpm -C apps/native ios",
    "dev:ios:local": "pnpm -C apps/native ios:local",
    "dev:components": "pnpm -C packages/web-components storybook",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@endfieldmap/web",
    "build:packages": "turbo run build --filter=!@endfieldmap/web --filter=!@endfieldmap/native",
    "build:components": "turbo run build --filter=@endfieldmap/web-components",
    "build:components:docs": "turbo run build --filter=@endfieldmap/web-components && pnpm -C packages/web-components build-storybook",
    "build:adapter:ol": "turbo run build --filter=@endfieldmap/map-adapter-ol",
    "build:adapter:maplibre": "turbo run build --filter=@endfieldmap/map-adapter-maplibre",
    "build:android": "turbo run build --filter=@endfieldmap/native^... && pnpm -C apps/native build:android",
    "build:ios": "turbo run build --filter=@endfieldmap/native^... && pnpm -C apps/native build:ios",
    "build:mobile": "turbo run build --filter=@endfieldmap/native^... && pnpm -C apps/native build:android && pnpm -C apps/native build:ios",
    "lng:type": "pnpm -C packages/map-service lng:type",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "publish:packages": "turbo run build && changeset publish --access public",
    "release": "bash scripts/release.sh",
    "clean": "rimraf packages/*/dist apps/*/dist .turbo packages/*/.turbo apps/*/.turbo packages/*/*.tsbuildinfo apps/*/*.tsbuildinfo *.tsbuildinfo"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.12.0",
    "prettier": "catalog:",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-dts": "1.0.3",
    "vite": "^8.2.2",
    "vitest": "catalog:"
  },
  "dependencies": {
    "rxdb": "catalog:"
  }
}
