{
  "name": "endfieldmap",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:tools && pnpm build:core && pnpm build:web",
    "build:core": "pnpm --filter \"./packages/map-core\" build",
    "build:tools": "pnpm --filter \"./packages/tools\" build",
    "build:web": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "lng:type": "i18next-cli types",
    "preview": "vite preview"
  },
  "dependencies": {
    "@endfieldmap/map-core": "workspace:*",
    "@endfieldmap/tools": "workspace:*",
    "@gsap/react": "^2.1.2",
    "@sentry/react": "^10.29.0",
    "@sentry/vite-plugin": "^4.6.1",
    "@tailwindcss/vite": "^4.1.17",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "i18next": "^25.6.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.3.5",
    "react-modal-sheet": "^5.2.1",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "yet-another-react-lightbox": "^3.25.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-class-static-block": "^7.28.3",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "i18next-cli": "^1.25.1",
    "prettier": "3.6.2",
    "sass-embedded": "^1.93.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "npm:rolldown-vite@7.2.7"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.7"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "unrs-resolver"
    ]
  }
}
