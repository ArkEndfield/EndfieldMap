{
  "name": "endfieldmap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev:web": "pnpm -C apps/web dev",
    "dev:native": "pnpm -C apps/native start",
    "dev:android": "pnpm -C apps/native android",
    "dev:android:local": "pnpm -C apps/native android:local",
    "dev:ios": "pnpm -C apps/native ios",
    "dev:ios:local": "pnpm -C apps/native ios:local",
    "dev:components": "pnpm -C packages/web-components storybook",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@endfieldmap/web",
    "build:packages": "turbo run build --filter=!@endfieldmap/web --filter=!@endfieldmap/native",
    "build:components": "turbo run build --filter=@endfieldmap/web-components",
    "build:components:docs": "turbo run build --filter=@endfieldmap/web-components && pnpm -C packages/web-components build-storybook",
    "build:adapter:ol": "turbo run build --filter=@endfieldmap/map-adapter-ol",
    "build:adapter:maplibre": "turbo run build --filter=@endfieldmap/map-adapter-maplibre",
    "build:android": "turbo run build --filter=@endfieldmap/native^... && pnpm -C apps/native build:android",
    "build:ios": "turbo run build --filter=@endfieldmap/native^... && pnpm -C apps/native build:ios",
    "build:mobile": "turbo run build --filter=@endfieldmap/native^... && pnpm -C apps/native build:android && pnpm -C apps/native build:ios",
    "lng:type": "pnpm -C packages/map-service lng:type",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "publish:packages": "turbo run build && pnpm -r publish --access public",
    "release": "bash scripts/release.sh",
    "clean": "find . -name 'dist' -type d -not -path '*/node_modules/*' -exec rm -rf {} + && rm -rf .turbo && find . -name '.turbo' -type d -not -path '*/node_modules/*' -exec rm -rf {} + && find . -name '*.tsbuildinfo' -not -path '*/node_modules/*' -delete"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-transform-class-properties": "^7.28.6",
    "@babel/plugin-transform-class-static-block": "^7.28.6",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.4.0",
    "prettier": "3.8.1",
    "turbo": "^2.8.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "unplugin-dts": "1.0.0-beta.6",
    "vite": "8.0.0-beta.16",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.0.0-beta.13",
      "typescript": "~5.9.3",
      "lightningcss": "1.30.1"
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@parcel/watcher",
      "@sentry/cli",
      "@swc/core",
      "esbuild",
      "protobufjs",
      "rxdb",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "rxdb": "^16.21.1"
  }
}
