{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@endfieldmap/map-adapter-ol": ["../map-adapter-ol/src/index.ts"],
      "@endfieldmap/map-adapter-ol/*": ["../map-adapter-ol/src/*"],
      "@endfieldmap/map-core": ["../map-core/src/index.ts"],
      "@endfieldmap/map-core/*": ["../map-core/src/*"],
      "@endfieldmap/tools": ["../tools/src/index.ts"],
      "@endfieldmap/tools/*": ["../tools/src/*"],
      "@endfieldmap/map-service": ["../map-service/src/index.ts"],
      "@endfieldmap/map-service/*": ["../map-service/src/*"],
      "@/": ["./src"],
      "@/*": ["./src/*"],
      "@eftypes/": ["./src/@types"],
      "@eftypes/*": ["./src/@types/*"],
      "@themes/": ["./src/components/themes"],
      "@themes/*": ["./src/components/themes/*"]
    }
  },
  "include": ["src", "./env.d.ts"]
}
