{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.build.tsbuildinfo",
    "paths": {
      "@endfieldmap/map-adapter-ol": ["../map-adapter-ol/src/index.ts"],
      "@endfieldmap/map-adapter-ol/*": ["../map-adapter-ol/src/*"],
      "@endfieldmap/map-core": ["../map-core/src/index.ts"],
      "@endfieldmap/map-core/*": ["../map-core/src/*"],
      "@endfieldmap/tools": ["../tools/src/index.ts"],
      "@endfieldmap/tools/*": ["../tools/src/*"],
      "@endfieldmap/map-service": ["../map-service/src/index.ts"],
      "@endfieldmap/map-service/*": ["../map-service/src/*"],
      "@/*": ["./src/*"],
      "@eftypes/*": ["./src/@types/*"],
      "@themes/*": ["./src/components/themes/*"]
    }
  }
}
