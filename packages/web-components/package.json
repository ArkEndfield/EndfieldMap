{
  "name": "@endfieldmap/web-components",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./style.css": "./dist/style.css",
    "./assets/*": "./dist/assets/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "mobx": "^6.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@endfieldmap/map-service": "workspace:*",
    "@endfieldmap/map-web-theme-types": "workspace:*",
    "@endfieldmap/tools": "workspace:*",
    "motion": "^12.12.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.2.10",
    "@tailwindcss/vite": "^4.1.17",
    "storybook": "^10.2.10",
    "tailwindcss": "^4.1.17"
  },
  "files": [
    "dist"
  ]
}