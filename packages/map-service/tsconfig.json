{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "erasableSyntaxOnly": false,
    "paths": {
      "@endfieldmap/map-service": ["./src/index.ts"],
      "@endfieldmap/map-service/*": ["./src/*"],
      "@endfieldmap/map-core": ["../map-core/src/index.ts"],
      "@endfieldmap/map-core/*": ["../map-core/src/*"],
      "@endfieldmap/tools": ["../tools/src/index.ts"],
      "@endfieldmap/tools/*": ["../tools/src/*"]
    }
  },
  "references": [{ "path": "../tools" }, { "path": "../map-core" }],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
