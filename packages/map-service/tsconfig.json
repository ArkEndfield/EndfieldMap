{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "erasableSyntaxOnly": false,
    "paths": {
      "@endfieldmap/map-service": ["./src/index.ts"],
      "@endfieldmap/map-service/*": ["./src/*"]
    }
  },
  "references": [{ "path": "../tools" }, { "path": "../map-core" }],
  "include": ["src/**/*", "src/**/*.json"],
  "exclude": ["node_modules", "dist"]
}
