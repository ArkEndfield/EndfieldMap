{
  "name": "@endfieldmap/map-service",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lng:type": "i18next-cli types"
  },
  "dependencies": {
    "@endfieldmap/map-core": "workspace:*",
    "@endfieldmap/tools": "workspace:*",
    "microdiff": "^1.5.0"
  },
  "devDependencies": {
    "i18next-cli": "^1.25.1"
  },
  "peerDependencies": {
    "@tanstack/react-db": "^0.1.68",
    "@tanstack/rxdb-db-collection": "^0.1.56",
    "i18next": "^25.8.0",
    "i18next-resources-to-backend": "^1.2.1",
    "mobx": "^6.15.0",
    "react-i18next": "^16.3.5",
    "rxdb": "^16.21.1",
    "rxjs": "^7.8.2"
  }
}
