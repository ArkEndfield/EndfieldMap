{
  "name": "@endfieldmap/map-service",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lng:type": "i18next-cli types"
  },
  "dependencies": {
    "@endfieldmap/tools": "workspace:*"
  },
  "devDependencies": {
    "i18next-cli": "^1.25.1"
  },
  "peerDependencies": {
    "i18next": "^25.8.0",
    "react-i18next": "^16.3.5",
    "i18next-resources-to-backend": "^1.2.1"
  }
}
