{
  "name": "@endfieldmap/map-service",
  "version": "0.1.0",
  "description": "Data services and business logic for EndfieldMap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArkEndfield/EndfieldMap.git",
    "directory": "packages/map-service"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "prepack": "cp ../../LICENSE . 2>/dev/null || true",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lng:type": "i18next-cli types"
  },
  "dependencies": {
    "microdiff": "^1.5.0"
  },
  "devDependencies": {
    "i18next-cli": "^1.43.0"
  },
  "peerDependencies": {
    "@endfieldmap/map-core": "workspace:*",
    "@endfieldmap/tools": "workspace:*",
    "i18next": "^25.8.13",
    "i18next-resources-to-backend": "^1.2.1",
    "mobx": "^6.15.0",
    "rxdb": "^16.21.1",
    "rxjs": "^7.8.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
