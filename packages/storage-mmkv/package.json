{
  "name": "@endfieldmap/storage-mmkv",
  "version": "0.1.0",
  "description": "MMKV storage adapter for EndfieldMap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArkEndfield/EndfieldMap.git",
    "directory": "packages/storage-mmkv"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "prepack": "cp ../../LICENSE . 2>/dev/null || true",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@endfieldmap/tools": "workspace:*"
  },
  "peerDependencies": {
    "@endfieldmap/tools": "workspace:*",
    "react-native-mmkv": "^4.1.2"
  },
  "peerDependenciesMeta": {
    "react-native-mmkv": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
