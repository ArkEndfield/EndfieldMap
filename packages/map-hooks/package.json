{
  "name": "@endfieldmap/map-hooks",
  "version": "1.0.0",
  "description": "React hooks for EndfieldMap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArkEndfield/EndfieldMap.git",
    "directory": "packages/map-hooks"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "prepack": "cp ../../LICENSE . 2>/dev/null || true",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "mobx": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "^17.0.9",
    "@endfieldmap/map-core": "workspace:*",
    "@endfieldmap/map-service": "workspace:*",
    "@endfieldmap/tools": "workspace:*",
    "@tanstack/react-db": "catalog:",
    "@tanstack/rxdb-db-collection": "catalog:",
    "rxdb": "catalog:",
    "rxjs": "catalog:"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
