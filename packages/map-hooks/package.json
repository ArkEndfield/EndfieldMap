{
  "name": "@endfieldmap/map-hooks",
  "version": "0.1.0",
  "description": "React hooks for EndfieldMap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArkEndfield/EndfieldMap.git",
    "directory": "packages/map-hooks"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "prepack": "cp ../../LICENSE . 2>/dev/null || true",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "mobx": "^6.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4",
    "@endfieldmap/map-core": "workspace:*",
    "@endfieldmap/map-service": "workspace:*",
    "@endfieldmap/tools": "workspace:*",
    "@tanstack/react-db": "^0.1.72",
    "@tanstack/rxdb-db-collection": "^0.1.60",
    "rxdb": "^16.21.1",
    "rxjs": "^7.8.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
