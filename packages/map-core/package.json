{
  "name": "@endfieldmap/map-core",
  "version": "1.0.0",
  "description": "Core mapping data structures and logic for EndfieldMap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArkEndfield/EndfieldMap.git",
    "directory": "packages/map-core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "@endfieldmap/tools": "workspace:*",
    "mobx": "^6.15.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
