{
  "name": "@endfieldmap/map-adapter-maplibre",
  "version": "0.1.0",
  "description": "MapLibre map adapter for EndfieldMap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArkEndfield/EndfieldMap.git",
    "directory": "packages/map-adapter-maplibre"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "prepack": "cp ../../LICENSE . 2>/dev/null || true",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "@endfieldmap/map-core": "workspace:*",
    "@endfieldmap/tools": "workspace:*",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "mobx": "^6.15.0"
  },
  "peerDependenciesMeta": {
    "@maplibre/maplibre-react-native": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
